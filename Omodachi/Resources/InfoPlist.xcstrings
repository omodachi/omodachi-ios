    },
    "CFBundleName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omodachi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Omodachi"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds paired Omodachi computers on this network. You still confirm the address and the credential."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本地网络里找已配对的 Omodachi 电脑。地址和凭据仍由你确认。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approves the password prompt on your computer with Face ID or Touch ID. This device never stores or sees that password."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Face ID 或 Touch ID 批准电脑上弹出的密码框。这台设备不保存、也看不到你的电脑密码。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends this device's microphone to the paired computer's virtual microphone while you hold to talk. The computer transcribes it; nothing is stored here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话时，把这台设备的麦克风送到已配对电脑的虚拟麦克风，由电脑自己转写。音频不在本机保存。"
          }
        }
      }
    }
  }
}

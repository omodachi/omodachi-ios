    },
    "CFBundleName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omodachi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Omodachi"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only when you choose “I don’t use Tailscale”: finds and connects to your Omodachi computer on this Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你选「我不用 Tailscale」时使用：在这个 Wi-Fi 上找到你的 Omodachi 电脑并连接它。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approves the password prompt on your computer with Face ID or Touch ID. This device never stores or sees that password."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Face ID 或 Touch ID 批准电脑上弹出的密码框。这台设备不保存、也看不到你的电脑密码。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonlight's game-controller support may use Bluetooth. Omodachi never scans for or connects to Bluetooth devices on its own."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonlight 的手柄支持可能用到蓝牙；Omodachi 不会主动扫描或连接蓝牙设备。"
          }
        }
      }
    }
  }
}

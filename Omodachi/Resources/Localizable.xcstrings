      }
    },
    "reason.sunshineControlUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunshine on the host is not answering."
          }
        },
        "zh-Hans": {

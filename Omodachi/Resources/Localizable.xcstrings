    "reason.notificationsUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your computer's notifications cannot be read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不到电脑上的通知。"
          }
        }
      }

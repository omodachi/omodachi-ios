      }
    },
    "reason.permissionDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host refused this request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机拒绝了这次请求。"
          }
        }
      }
    },
    "reason.pluginCredential": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is the Omodachi panel's own credential on the computer; it cannot be renewed or revoked from here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是电脑上 Omodachi 面板自己的凭据，不能从这里续期或撤销。"
          }
        }
      }
    },
    "reason.preferencesInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host's preferences are invalid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机的偏好设置无效。"
          }
        }
      }

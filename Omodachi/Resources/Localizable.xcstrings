    "remote.compose.fieldHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write with this device's keyboard. The keyboard's Send types it into the focused window on the computer and presses Return; the button at the right of the field types it without Return. While the field is empty, Delete, Return and the like go straight to the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用本机输入法写。按键盘上的发送：打进电脑上当前的窗口并按回车；只插入不回车用输入框右边的按钮。输入框空着时，删除、回车这些键直接发给电脑。"
          }
        }
      }
    },

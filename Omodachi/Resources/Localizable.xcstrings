    "reason.invalidWorkspace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That workspace is no longer in the host's layout."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 workspace 已经不在主机的布局里了。"
          }
        }
      }
    },
    "reason.invalidWorkspaceName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name is one line, up to 64 characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字只能一行，最多 64 个字符。"
          }
        }

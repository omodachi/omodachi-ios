      }
    },
    "reason.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host is receiving too many requests. Try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机收到的请求太多，稍后再试。"
          }
        }
      }
    },
    "reason.releaseFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host could not release this session. It will time out on its own."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机没能收回这次会话，稍后会自己超时。"
          }
        }
      }
    },
    "reason.remote.permissionDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This remote session belongs to another device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 Remote 会话属于另一台设备。"
          }
        }
      }
    },
    "reason.remote.sessionExists": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This computer already has a remote session. End it on the device that holds it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机上已经有一个 Remote 会话。请先在原设备上结束它。"
          }
        }
      }
    },
    "reason.remote.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host could not finish this remote request (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机未能完成这次 Remote 请求（%@）。"
          }
        }
      }
    },
    "reason.remoteRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host refused this remote request. Reconnect and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机拒绝了这次 Remote 请求。请刷新连接后重试。"
          }
        }
      }
    },
    "reason.remoteRuntimeUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This computer has no graphical session, so Remote cannot start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台电脑现在没有图形会话，开不了 Remote。"
          }
        }
      }
    },
    "reason.remoteSessionRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote holds this host's workspaces. Switch inside the picture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote 正在用这台主机的工作区。请在 Remote 画面里切换。"
          }
        }
      }
    },
    "reason.resizeFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host could not resize the picture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机没能按新的尺寸调整画面。"
          }
        }
      }
    },

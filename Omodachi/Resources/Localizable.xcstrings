    "demo.agentAnswer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation is part of the demo, written into the app so you can see the Agent panel. On a paired computer you talk here with the coding agent running there: it works on that computer, and before it runs a command or changes a file, it asks you here first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段对话是演示，写在 app 里，让你看看 Agent 面板。配对电脑后，你在这里和那台电脑上的编程代理对话：它在电脑上干活，要运行命令或改文件之前，会先在这里问你。"
          }
        }
      }
    },
    "demo.agentAsk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can I do from this panel?"
          }

          "stringUnit": {
            "state": "translated",
            "value": "Your computer, the bar and Remote's choices all live here. This tour does too, near the top: Show the tour again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑、bar 和 Remote 的选项都在这里。这段导览也在，就在靠上的「再看一遍导览」。"

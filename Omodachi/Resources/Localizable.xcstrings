    "settings.showUnrunnable.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host binds these keys to Lua functions with no executable record, so this device can never run them. On, they come back to the list, still greyed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机把这几条快捷键绑在 Lua 函数上，没有可执行的记录，这台设备永远跑不了。打开后它们回到列表里，仍然是灰的。"
          }
        }
      }
    },

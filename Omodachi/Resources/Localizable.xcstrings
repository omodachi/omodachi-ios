    "reason.noBackup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your computer has no backup to roll back to."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑端没有可回滚的备份。"
          }

    "tour.remote.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your computer's screen, right on this device. Use it as one more screen beside the computer, or take over the whole desktop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑的屏幕，就在这台设备上。可以把它当成电脑旁边的又一块屏，也可以接管整个桌面。"
          }
        }
      }
    },

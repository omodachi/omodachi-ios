    "settings.clipboard.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One way: what you copy on the computer arrives here. Both ways: what you copy here goes to the computer too. The computer has to turn it on as well. Text only, up to 64 KB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单向：主机上复制的文字自动到这台设备。双向：这台设备复制的文字也送到主机。主机那边也要打开。只同步文字，上限 64 KB。"
          }
        }
      }
    },

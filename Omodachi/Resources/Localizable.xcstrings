      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "tour.herdr.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch your agents at work in their panes, and type into any of them. Quick sends the usual replies in one tap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看着 agent 们在各自的 pane 里干活，也能往任何一个里打字。「快捷」一点就发出常用的回复。"
          }
        }
      }
    },

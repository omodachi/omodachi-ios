      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name is letters, digits and . _ - only, starting with a letter or a digit, up to 32 characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字只能用字母、数字和 . _ -，以字母或数字开头，最多 32 个字符。"
          }
        }
      }

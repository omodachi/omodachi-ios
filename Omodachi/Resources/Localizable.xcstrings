    "ssh.failed.auth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host accepted the connection but did not authenticate within %@s."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机接受了连接，但 %@ 秒内没有通过认证。"
          }
        }
      }
    },
    "ssh.failed.handshake": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host accepted the connection but did not finish the handshake in %@s."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机接受了连接，但 %@ 秒内没有完成握手。"
          }
        }
      }
    },
    "ssh.failed.hostKeyWait": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host fingerprint was not confirmed, so the connection was dropped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没确认主机指纹，连接已放弃。"
          }
        }
      }
    },
    "ssh.failed.shell": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed in, but no terminal arrived in %@s."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录成功，但 %@ 秒内没有拿到终端。"
          }
        }
      }
    },
    "ssh.failed.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot reach port 22 on the host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上主机的 22 端口。"
          }
        }
      }
    },
    "ssh.gaveUp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several attempts failed, so it has stopped. Tap Reconnect to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续几次都没连上，已停止重试。点「重连」再试。"
          }
        }
      }
    },
    "ssh.hostKeyChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host key changed, so the connection was refused. Verify the host before resetting its pin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机密钥变了，连接已拒绝。核实这台主机后再重设它的固定值。"
          }
        }
      }
    },
    "ssh.hostKeyDeclined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host key was not trusted. Nothing connected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有信任这个主机密钥，什么都没连。"
          }
        }
      }
    },
    "ssh.hostKeyRejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host key was rejected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机密钥被拒绝。"
          }
        }
      }
    },
    "ssh.hostSessionMayRun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session on the host may still be running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机上的会话可能还在跑。"
          }
        }
      }
    },
    "ssh.importKeyFirst": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no SSH key for this computer. Forget the computer in Settings and pair it again; pairing makes a new key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备还没有这台电脑的 SSH 密钥。在设置里忘记这台电脑、再配对一次，配对时会生成新的密钥。"
          }
        }
      }
    },
    "ssh.keyNotAuthorized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing did not write this device's public key to the host. Forget this device on the computer and pair again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对没能把这台设备的公钥写进主机。在电脑上忘记这台设备后重新配对。"
          }
        }
      }
    },
    "ssh.keyRejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host refused this device's SSH key. Forget the host in Settings and pair again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机拒绝了这台设备的 SSH 密钥。在设置里忘记这台主机，再配对一次。"
          }
        }
      }
    },
    "ssh.keyReplaceRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host would not take this device's new SSH key. Forget the host in Settings and pair again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机没有接受这台设备的新 SSH 密钥。在设置里忘记这台主机，再配对一次。"
          }
        }
      }
    },
    "ssh.keyReplaceUnreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host could not be reached, so this device's SSH key was not registered again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联系不上主机，没能重新登记这台设备的 SSH 密钥。"
          }
        }
      }
    },
    "ssh.keyReplacing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host does not recognise this device's key; registering it again…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机不认得这台设备的密钥，正在重新登记…"
          }
        }
      }
    },

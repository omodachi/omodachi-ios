      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host's event queue overflowed. Refresh its state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机的事件队列满了，请刷新状态。"

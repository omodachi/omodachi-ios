            "state": "translated",
            "value": "The host could not finish this Herdr request (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机未能完成这次 Herdr 请求（%@）。"
          }
        }
      }
    },
    "reason.herdrActionUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host's Herdr bridge has no route for that action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机的 Herdr 桥不支持这个动作。"
          }
        }
      }
    },
    "reason.herdrAgentBlocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent is waiting on a question, so nothing was typed; answer it with the choices above the box, or with the keys (1, ↓ ↩ or esc)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "agent 正停在一个问题上，所以一个字都没打进去；用输入框上面的选项回答它，或者用按键（1、↓ ↩ 或 esc）。"
          }
        }
      }
    },
    "reason.herdrControlInUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another end is driving this pane. You are watching, read-only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一端正在控制这个 pane。当前是只读观察。"
          }
        }
      }
    },
    "reason.herdrKeyUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Herdr cannot send PageUp, PageDown, Home, End, Insert or Delete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Herdr 发不了 PageUp、PageDown、Home、End、Insert 和 Delete。"
          }
        }
      }
    },
    "reason.herdrLaunchNotAllowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That isn’t one of this computer’s launchers any more. Close the card and open it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑上已经没有这个启动项了。关掉卡片再打开一次看看。"
          }
        }
      }
    },
    "reason.herdrNotRequested": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text got there; Enter was not pressed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字送到了，没有按回车。"
          }
        }
      }
    },
    "reason.herdrNotSeen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text never showed up in the pane, so Enter was not pressed. A dialog may have the focus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字没有出现在 pane 里，所以没有按回车。可能有个对话框拿着焦点。"
          }
        }
      }

    },
    "reason.invalidWorkspaceRequest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This layout request is incomplete, so nothing was sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次布局请求不完整，没有发送。"
          }
        }
      }
    },
    "reason.liveStateUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host's live state cannot be read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不到主机的实时状态。"
          }
        }
      }
    },
    "reason.media.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host could not finish this pairing (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机未能完成这次配对（%@）。"
          }
        }
      }
    },
    "reason.mediaBindingMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device's Remote certificate still belongs to an older pairing of this device. On the computer, open Omodachi › Devices, remove the older entry, then pair again here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备的远程证书还挂在它以前的一次配对上。在电脑上打开 Omodachi › 设备，移除那条旧记录，再回来点一次配对。"
          }
        }
      }
    },
    "reason.mediaCapacity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host has too many pending pairings. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机上待处理的配对太多，稍后再试。"
          }
        }
      }
    },
    "reason.mediaCertificateAssociated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That certificate is already paired with the host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张证书已经和主机配对过了。"
          }
        }
      }
    },
    "reason.mediaGrantRevoked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host revoked this device's streaming grant."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机撤销了本设备的串流授权。"
          }
        }
      }
    },
    "reason.mediaInvalidPin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PIN is not four digits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN 不是四位数字。"
          }
        }
      }
    },
    "reason.mediaNotFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That pairing attempt is no longer on the host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次配对尝试已经不在主机上了。"
          }
        }
      }
    },
    "reason.mediaPairingRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunshine has not approved this device's streaming certificate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunshine 还没批准这台设备的串流证书。"
          }
        }
      }
    },
    "reason.mediaPairingUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host is not running the managed Sunshine pairing bridge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机没有在跑受管 Sunshine 的配对桥。"
          }
        }
      }
    },
    "reason.mediaPermissionRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host has not authorized this device to stream. Approve it on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机还没有授权本设备串流。请在电脑上批准。"
          }
        }
      }
    },
    "reason.mediaPinSpent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That one-time code is spent. Leave and repair the pairing again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次配对的一次性验证码已经用过了。退出后再补一次配对。"
          }
        }
      }
    },
    "reason.mediaRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host refused this pairing request. Reconnect and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机拒绝了这次配对请求。请刷新连接后重试。"
          }
        }
      }
    },
    "reason.mediaRequestNotPending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That pairing request is no longer pending. Start again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个配对请求已经不在等待中，请重新发起。"
          }
        }
      }
    },
    "reason.mediaRequestNotUnique": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host has no single pending request for this device. Start again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机上没有正好一个属于本设备的待配对请求。请重新发起。"
          }
        }
      }
    },
    "reason.mediaRevocationPending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host is still revoking the old certificate. Try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机还在撤销上一张证书，稍后再试。"

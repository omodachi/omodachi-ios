    "reason.herdrSessionExists": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer already has a session by that name. Pick another name, or choose it from the list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑上已经有一个叫这个名字的会话了。换个名字，或者在列表里选它。"

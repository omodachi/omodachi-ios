    "alerts.actions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the agent asks for approval, you can allow or deny it right on the alert. If your %@ is locked, Face ID or your passcode comes first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 请你批准时，可以直接在提醒上允许或拒绝；%@ 锁着屏时先要用面容 ID 或密码解锁。"
          }
        }
      }
    },
    "alerts.atDesk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alert me even when I’m at the computer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人在电脑前也提醒我"
          }
        }
      }
    },
    "alerts.atDesk.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: while you’re using the computer, alerts wait. Once it has sat idle for two minutes or is locked, whatever is still waiting rings here, and anything you answered there is left out. Herdr alerts always wait 30 seconds first, and several waiting panes come as one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关着时：你正在用电脑，提醒就先等着。电脑闲置两分钟或锁屏后，还没处理的才会响，已经在电脑上处理掉的不再响。Herdr 的提醒总会先等 30 秒，好几个 pane 在等时合成一条。"
          }
        }
      }
    },
    "alerts.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications for Omodachi are turned off in this %@'s Settings. You can turn them back on there whenever you like."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 %@ 的「设置」里关掉了 Omodachi 的通知。想要的话，可以在那里重新打开。"
          }
        }
      }
    },
    "alerts.finished": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me when an agent finishes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "agent 做完时告诉我"
          }
        }
      }
    },
    "alerts.finished.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One alert when the Agent, or an agent in Herdr, finishes and you haven’t looked yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 或 Herdr 里的 agent 做完一件事、而你还没看时，提醒一次。"
          }
        }
      }
    },
    "alerts.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the app is closed or your %1$@ is locked, only %2$@ can reach you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 关着、或者 %1$@ 锁着屏的时候，只有 %2$@ 能找到你。"
          }
        }
      }
    },
    "alerts.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn them on and this %@ tells you when the agent or a Herdr pane is waiting for you, whichever panel you are in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开以后，agent 或 Herdr 里的 pane 在等你时，这台 %@ 会提醒你，不管你在哪个面板。"
          }
        }
      }
    },
    "alerts.on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the agent or a Herdr pane is waiting for you, this %@ tells you, whichever panel you are in, and for a few seconds after you leave the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

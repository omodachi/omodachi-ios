    "reason.sunshineAssetsMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunshine is encoding in software, so latency will be high."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunshine 在软件编码，延迟会明显偏高。"

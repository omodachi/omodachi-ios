    "hint.herdr": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type here, or use the keys below. Type sends every key you press straight in, full-screen apps like vim included. Tap the screen to put the keyboard away; double-tap it to switch between fit to width and actual size."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里写，或者用下面的按键。「直接输入」会把你按的每个键都送进去，vim 这类全屏程序也一样。点一下画面可以收起键盘；双击画面，可以在适应宽度和原始大小之间切换。"
          }
        }
      }
    },
    "hint.herdr.compact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap the screen to switch between Wrap, Fit to width and Actual size. Keys holds Esc, the arrows and ^C."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击画面，在换行显示、适应宽度和原始大小之间切换。「按键」里有 Esc、方向键和 ^C。"
          }
        }
      }
    },

    "ssh.tailscaleSSH": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This computer uses Tailscale SSH. Over Tailscale, port 22 is answered by Tailscale, not by the computer's SSH server, so Omodachi's key and approval are not used and Tailscale may ask you to sign in in a browser. Turn it off on the computer with tailscale set --ssh=false."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台电脑开着 Tailscale SSH。经 Tailscale 连接时，22 端口由 Tailscale 接管，不经过电脑的 SSH 服务，所以 Omodachi 的密钥和授权都不起作用，Tailscale 可能还要你在浏览器里登录。在电脑上运行 tailscale set --ssh=false 关掉它。"
          }
        }
      }
    },

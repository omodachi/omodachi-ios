    "pair.credentialUnverified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That computer did not say whether this credential still counts, so nothing was deleted. Check that Omodachi is running on it and tap again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台电脑没回答本机凭据还算不算数，所以先不动它。确认它上面的 Omodachi 在跑，再点一次。"
          }
        }
      }
    },
    "pair.error.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This computer has too many pairing requests waiting. Approve or reject them there, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台电脑上等着的配对请求太多了。先在电脑上批准或拒绝它们，再试一次。"
          }
        }
      }
    },
    "pair.error.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing was cancelled. Tap the row again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对已取消。回到列表再点一次。"
          }
        }
      }
    },
    "pair.error.deviceRegistered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That computer still holds this device's grant (%@) but this device lost its credential. Revoke it there and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台电脑上还留着本设备的授权（%@），本机的凭据却没了。在电脑上撤销它再试。"
          }
        }
      }
    },
    "pair.error.existingCredential": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device still holds an old credential for that computer. Tap its row again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机还留着这台电脑的旧凭据。回到列表再点一次这一行。"
          }
        }
      }
    },

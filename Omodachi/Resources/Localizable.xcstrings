    "reason.profileUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host cannot plan a picture for this screen's shape or density."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机无法为当前屏幕比例或密度生成画面规格。"

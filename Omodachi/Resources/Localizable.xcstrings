    "reason.providerAdapterUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host cannot reach this agent's provider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机连不上这个 agent 的服务商。"

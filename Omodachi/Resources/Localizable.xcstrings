    "tour.agent.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk with the agent on your computer, and send it a photo or a file. Before it runs a command or changes a file, it asks you here first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和电脑上的 agent 聊天，也能发照片或文件给它。它要运行命令或改文件之前，会先在这里问你。"
          }
        }
      }
    },
    "tour.agent.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent"
          }
        }
      }
    },
    "tour.bar.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every panel is one tap away on this bar, and the logo opens your computer's Omarchy menu. Hold an icon to see its name, or hold an empty spot to move the bar to the other edge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个面板都在这条 bar 上，一点就到；点 logo 是电脑的 Omarchy 菜单。按住图标能看到它的名字，按住空白处可以把 bar 挪到另一边。"
          }
        }
      }
    },
    "tour.bar.title": {
      "extractionState": "manual",

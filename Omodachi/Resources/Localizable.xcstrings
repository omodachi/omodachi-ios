    "reason.herdrPaneGone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That pane is no longer on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "pane 已经不在电脑上了。"
          }
        }
      }
    },
    "reason.herdrRequestFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Herdr refused that action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Herdr 拒绝了这次操作。"
          }
        }
      }

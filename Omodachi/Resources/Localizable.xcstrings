    "where.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Tailscale app on this %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 %@ 上打开 Tailscale app。"
          }
        }
      }
    },
    "where.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It lists your devices by name. The computer's is its host name, often omarchy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它按名字列出你的设备。电脑的名字就是它的主机名，Omarchy 上常叫 omarchy。"
          }
        }
      }
    },
    "where.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold its row, or open it, and copy the name or the 100.x address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住那一行或点进去，复制名字或 100.x 地址。"
          }
        }
      }
    },
    "where.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back and tap Paste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到这里，点「粘贴」。"
          }
        }
      }
    },

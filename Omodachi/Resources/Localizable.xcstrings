    },
    "demo.agentReply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the demo, so your message went nowhere. On a paired computer it goes to the coding agent running there, and the agent's answers, and anything it asks you to approve, appear in this panel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是演示，你的消息没有发到任何地方。配对电脑后，它会交给那台电脑上的编程代理，代理的回答和它请你批准的操作都会出现在这个面板里。"
          }
        }
      }
    },
